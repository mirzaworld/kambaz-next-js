{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "overrides": [
    {
      "files": [
        "app/(kambaz)/courses/**/assignments/**/*.{ts,tsx}",
        "app/(kambaz)/courses/**/modules/**/*.{ts,tsx}",
        "app/(kambaz)/courses/**/people/**/*.{ts,tsx}",
        "app/(kambaz)/courses/**/layout.{ts,tsx}",
        
        "app/(Kambaz)/Courses/**/assignments/**/*.{ts,tsx}",
        "app/(Kambaz)/Courses/**/modules/**/*.{ts,tsx}",
        "app/(Kambaz)/Courses/**/people/**/*.{ts,tsx}",
        "app/(Kambaz)/Courses/**/layout.{ts,tsx}"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off"
      }
    },
    {
      "files": [
        "app/labs/lab3/**/*.{ts,tsx}"
      ],
      "rules": {
        "prefer-const": "off"
      }
    },
    {
      "files": ["app/**/*.{ts,tsx}"],
      "rules": {
        "@next/next/no-img-element": "warn",
        "jsx-a11y/alt-text": "warn",
        "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
      }
    }
  ]
}
